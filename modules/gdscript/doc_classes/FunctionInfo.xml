<?xml version="1.0" encoding="UTF-8" ?>
<class name="FunctionInfo" inherits="RefCounted" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		Read-only view of one GDScript function.
	</brief_description>
	<description>
		Built by [ReflectionUtils] from a [MethodInfo]. No setters. Argument names come from that method's arguments.
	</description>
	<members>
		<member name="argument_count" type="int" setter="" getter="get_argument_count" default="0">
			Number of arguments in [member arguments].
		</member>
		<member name="arguments" type="PackedStringArray" setter="" getter="get_arguments" default="PackedStringArray()">
			Argument names, in declaration order.
		</member>
		<member name="is_static" type="bool" setter="" getter="get_is_static" default="false">
			[code]true[/code] when the method flags include static.
		</member>
		<member name="name" type="StringName" setter="" getter="get_name" default="&amp;&quot;&quot;">
			The function name.
		</member>
		<member name="gdscript" type="GDScript" setter="" getter="get_gdscript">
			The script that declares the function.
		</member>
	</members>
</class>
